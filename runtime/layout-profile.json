                                                           "decoration":  "minimal",
                                                           "page_numbers":  "omit_or_editor_added",
                                                           "print_ready_claim_allowed":  false
                                                       },
                              "print_preview":  {
                                                    "enabled":  true,
                                                    "purpose":  "A5 book-like proof for reading and layout inspection",
                                                    "chapter_start":  "new_page",
                                                    "page_numbers":  "allowed_when_encoded",
                                                    "print_ready_claim_allowed":  false
